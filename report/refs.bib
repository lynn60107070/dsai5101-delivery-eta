% --- T1, Lynn (related work: promise setting / on-time delivery, and leakage) ---

% Lynn: Uses a food-delivery platform's data to predict travel times and feeds them into order
% assignment to improve on-time delivery. Same operational goal as our promise test, but they act on
% dispatch (who delivers) while we act on the promise itself, using only order-time information.
@article{liu2021ontime,
  author  = {Liu, Sheng and He, Long and Shen, Zuo-Jun Max},
  title   = {On-Time Last-Mile Delivery: Order Assignment with Travel-Time Predictors},
  journal = {Management Science},
  volume  = {67},
  number  = {7},
  pages   = {4095--4119},
  year    = {2021},
  doi     = {10.1287/mnsc.2020.3741}
}

% Lynn: Surveys leakage across 17 fields (294 affected papers) and gives a taxonomy of eight leakage
% types; also cited in Lec 6. Motivates our leakage audit: we show how much error drops when
% after-order times leak in, and why the deployable model must exclude them.
@article{kapoor2023leakage,
  author  = {Kapoor, Sayash and Narayanan, Arvind},
  title   = {Leakage and the Reproducibility Crisis in Machine-Learning-Based Science},
  journal = {Patterns},
  volume  = {4},
  number  = {9},
  pages   = {100804},
  year    = {2023},
  doi     = {10.1016/j.patter.2023.100804}
}

% Lynn (methods, not related work): quantile regression, the basis of the 80th-percentile promise
% model and the pinball loss we evaluate it with. Cite in Methodology.
@article{koenker1978quantiles,
  author  = {Koenker, Roger and Bassett, Jr., Gilbert},
  title   = {Regression Quantiles},
  journal = {Econometrica},
  volume  = {46},
  number  = {1},
  pages   = {33--50},
  year    = {1978},
  doi     = {10.2307/1913643}
}

% --- T1, Mahmoud (added by Lynn): related work on delivery-time / ETA prediction ---

% Mahmoud: Estimates the full order-to-delivery time ("order fulfillment cycle time") for Ele.me's food
% delivery platform; the model is deployed there. Closest prior work to ours (same target, same setting),
% but built on rich proprietary platform data. We use a public dataset with order-time features only,
% tree ensembles, an explicit leakage audit, and a comparison against the platform's own promise.
@inproceedings{zhu2020fulfillment,
  author    = {Zhu, Lin and Yu, Wei and Zhou, Kairong and Wang, Xing and Feng, Wenxing and Wang, Pengyu and
               Chen, Ning and Lee, Pei},
  title     = {Order Fulfillment Cycle Time Estimation for On-Demand Food Delivery},
  booktitle = {Proceedings of the 26th ACM SIGKDD International Conference on Knowledge Discovery \& Data Mining},
  pages     = {2571--2580},
  year      = {2020},
  doi       = {10.1145/3394486.3403307}
}

% Mahmoud: Travel-time (ETA) estimation for DiDi ride-hailing with a Wide-Deep-Recurrent (WDR) model
% learned from large-scale trip data. Shows ETA prediction as a learning problem at industry scale; food
% delivery adds a restaurant preparation stage before the ride, which our stage analysis separates out.
@inproceedings{wang2018travel,
  author    = {Wang, Zheng and Fu, Kun and Ye, Jieping},
  title     = {Learning to Estimate the Travel Time},
  booktitle = {Proceedings of the 24th ACM SIGKDD International Conference on Knowledge Discovery \& Data Mining},
  pages     = {858--866},
  year      = {2018},
  doi       = {10.1145/3219819.3219900}
}

